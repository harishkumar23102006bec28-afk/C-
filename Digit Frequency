#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() {
    
    char s[1001];
    scanf("%1000s", s);
    

    int frequency[10] = {0};
    
    
    for (int i = 0; s[i] != '\0'; i++) {
      
        if (s[i] >= '0' && s[i] <= '9') {
            
            frequency[s[i] - '0']++;
        }
    }
    
   
    for (int i = 0; i < 10; i++) {
        printf("%d ", frequency[i]);
    }
    printf("\n");
    
    return 0;
}
